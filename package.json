{
  "name": "url-shortener",
  "version": "1.0.0",
  "description": "URL shortener with Base62 encoding, Redis caching, rate limiting and async click analytics",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "loadtest": "node scripts/loadtest.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bullmq": "^6.7.8",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1"
  }
}
