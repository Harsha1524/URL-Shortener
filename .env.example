# Copy this file to .env and adjust if needed
PORT=3000
BASE_URL=http://localhost:3000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener

# Redis (used for cache, rate limiting AND the job queue)
REDIS_URL=redis://localhost:6379

# Cache: how long a code -> URL mapping stays in Redis (seconds)
CACHE_TTL_SECONDS=3600
# Negative cache: how long we remember "this code does not exist" (seconds)
NEGATIVE_CACHE_TTL_SECONDS=60

# Rate limiting (fixed window, per IP)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_SHORTEN_MAX=10
RATE_LIMIT_REDIRECT_MAX=100

# Added to the DB id before Base62 encoding so the first codes aren't "1", "2", "3"...
ID_OFFSET=100000

# 0 = links never expire. The public demo uses 7.
LINK_TTL_DAYS=0

# true = run the click worker inside the API process (for one-process free hosting).
# Locally, leave false and run `npm run worker` in a second terminal.
RUN_WORKER_IN_PROCESS=false

# Number of proxies in front of the app ("true"/"false" also allowed). Affects req.ip.
TRUST_PROXY=1

# Shown in the demo page footer (optional)
AUTHOR_NAME=
AUTHOR_URL=
SOURCE_URL=
